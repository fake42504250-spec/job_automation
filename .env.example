# Safe default: the system generates drafts but sends nothing.
DRY_RUN=true

TIMEZONE=Asia/Kolkata
RUN_AT=09:00
DAILY_SEND_LIMIT=8
MIN_JOB_SCORE=60
MAX_CONTACTS_PER_COMPANY=2
FOLLOW_UP_DAYS=4,9

GMAIL_JOB_ALERT_LABEL=Job Alerts
GMAIL_CREDENTIALS_FILE=config/gmail_credentials.json
GMAIL_TOKEN_FILE=data/gmail_token.json
PROFILE_FILE=config/profile.yaml
DATABASE_FILE=data/job_automation.db

# Optional. Without this key, only emails explicitly found in job descriptions
# or on public company pages are used.
HUNTER_API_KEY=

# Optional comma-separated RSS/Atom feeds.
JOB_FEED_URLS=

